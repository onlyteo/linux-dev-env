[user]
    name = Teo
    email = dev@onlyteo.com
    signingkey = ~/.ssh/id_ed25519
[alias]
    a = add
    aa = add --all
    co = checkout
    cob = checkout -b
    ci = commit
    cia = commit --amend
    cian = commit --amend --no-edit
    cim = commit -m
    cl = clone
    br = branch
    brd = branch -d
    brdd = branch -D
    bru = branch -u origin/\"$(git rev-parse --abbrev-ref HEAD)\"
    st = status
    sts = status -s
    nice = log --all --graph --decorate --oneline
    ll = log --all --graph --decorate --date=format:\"%Y-%m-%d %H:%M:%S\" --pretty=format:\"%C(yellow)%h%Creset %C(auto)%d%Creset %s %C(cyan)[%an <%ae> (%cn <%ce>) %cd]%Creset\" --abbrev-commit
    undo = checkout -- .
    unstage = reset --
    purge = !git reset -- && git checkout -- .
[core]
    editor = vim
    autocrlf = input
    longpaths = true
    excludesfile = ~/.gitignore_global
[push]
    default = simple
    autoSetupRemote = true
[fetch]
    prune = true
[init]
    defaultBranch = main
[gpg]
    format = ssh
[commit]
    gpgsign = true
